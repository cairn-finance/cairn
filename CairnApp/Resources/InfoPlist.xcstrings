    "NSFinancialDataUsageDescription" : {
      "comment" : "Shown when the app asks for permission to read Apple Wallet financial data.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cairn reads the Apple Wallet accounts you choose — Apple Card, Apple Cash, and Savings — so it can show their balances and transactions. It is read-only, and it stays on your device unless you turn on iCloud Sync."
