# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/
*.xcuserstate

## Generated project (XcodeGen owns project.yml)
*.xcodeproj/
*.xcodeproj/xcuserdata/

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xcplayground
xcplayground

# Swift Package Manager
# Package.resolved is intentionally committed once remote dependencies exist,
# so builds stay reproducible.
.build/
.swiftpm/

# DerivedData
DerivedData/
build/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Local App Store screenshot captures. Kept out of the repo so a broad
# `git add -A` can never sweep in tens of megabytes of PNGs; use `git add -f`
# if you deliberately want them tracked.
Screenshots/

# macOS
.DS_Store

# Local tooling
.env
*.local.xcconfig
Config/Signing.local.xcconfig

# Signing identities and provisioning profiles — these prove identity, never commit.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
