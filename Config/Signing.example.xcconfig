// Copy this file to `Config/Signing.local.xcconfig` and fill in your values.
// That file is git-ignored, so your team and bundle id never enter the repo.
//
//     cp Config/Signing.example.xcconfig Config/Signing.local.xcconfig
//
// Then run `xcodegen generate`.

// Your 10-character Team ID. Find it in the Apple Developer portal under
// Membership Details, or in Xcode → Settings → Accounts.
DEVELOPMENT_TEAM = ABCDE12345

// A bundle identifier unique to your team. Use reverse-DNS for a domain you
// control. Apple registers this as your App ID.
PRODUCT_BUNDLE_IDENTIFIER = com.yourname.cairn

// The CloudKit container is derived automatically as
// `iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)`, so no separate setting is needed. It
// must exist under your team (and be enabled for the App ID) before Release
// builds sync through iCloud. See docs/architecture.md.
